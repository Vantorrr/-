# Скопируйте в .env. Пустые Telegram-переменные — нормальный режим:
# пайплайн работает и пишет дайджест в data/digests/, отправку не имитирует.

DATABASE_URL=postgresql+psycopg://intake:intake@postgres:5432/intake
REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FETCH_INTERVAL_MINUTES=30
SEND_MODE=confirmation
DATA_DIR=data
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=25
HTTP_MIN_INTERVAL_SECONDS=2
# Пустые значения оставляют детерминированный шаблон. Ключ в репозиторий не класть.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
